# Production settings for www.varians.no.
#
# Copy this to `.env` on the server once, fill in APP_KEY, and leave it there:
# `.env` is gitignored, so deployments never overwrite it.
#
#   cp .env.production.example .env
#   php artisan key:generate
#
# After changing anything here, run `php artisan optimize:clear` — deploy.sh
# caches the configuration, and a cached config ignores later edits to .env.

APP_NAME=Varians
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.varians.no

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` would write every query and stack trace to disk on a shared host.
LOG_LEVEL=warning

# An absolute path, and above the document root: the file holds sessions and
# users, and must never be reachable over HTTP. Replace USER with your account.
DB_CONNECTION=sqlite
DB_DATABASE=/home/USER/varians/database/database.sqlite

# Sessions, cache and queue all live in the database, so nothing else has to be
# installed on the host. There is no queue worker: nothing in this application
# dispatches a job.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The site is HTTPS-only, so the session cookie should never travel otherwise.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail is unconfigured: nothing sends any yet, and `log` keeps it that way
# without failing. Fill in real credentials before enabling password resets.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@varians.no"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
