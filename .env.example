# Settings of a Varians installation run with Docker Compose (compose.yaml).
# Copy to .env beside compose.yaml and edit; docs/install.md explains each.
# Quote a value that contains spaces or < >, as MAIL_FROM below.

# The public address of the site, as visitors type it: used in links, in
# mail, and to check that forms are sent from the site itself.
ORIGIN=https://editions.example.org

# The domain Caddy obtains a certificate for (with --profile tls only): the
# host name of ORIGIN.
DOMAIN=editions.example.org

# The database's password. Letters and digits only, since it is written
# into a connection address: for instance the output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# The installation's name, used in mail, citations and package metadata.
SITE_NAME=Varians

# The licence of published scholarly records: CC-BY-SA-4.0, CC-BY-4.0 or CC0-1.0.
DATA_LICENCE=CC-BY-SA-4.0

# Mail over SMTP, for the confirmation of addresses and password resets.
# Leave SMTP_URL empty to run without mail: accounts are then not confirmed,
# and passwords are reset by an administrator (see docs/install.md).
#   smtps://user:password@mail.example.org:465   (TLS from the start)
#   smtp://user:password@mail.example.org:587    (STARTTLS)
# Characters such as @ or : in the user or password are written %40 and %3A.
SMTP_URL=
MAIL_FROM="Varians <noreply@editions.example.org>"

# The largest request body accepted, in bytes (image uploads): 100 MB.
BODY_SIZE_LIMIT=104857600

# The proxy in front (Caddy, or your own) gives the visitor's address in
# X-Forwarded-For; the limits on logins and resets count by it.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Optional: hours between the nightly archive passes (default 24), or
# ARCHIVE_SCHEDULER=off.
# ARCHIVE_INTERVAL_HOURS=24

# Optional: how many backups `varians backup` keeps in /data/backups (default 14).
# BACKUP_KEEP=14

# Optional: if you run a changed Varians, the address of its source code,
# which the footer links (the AGPL requires that you offer it).
# SOURCE_URL=https://example.org/your/varians

# Optional: the image tag to run (default latest), for instance 0.2.0 to stay on a release.
# VARIANS_VERSION=0.2.0

# Optional: the port on this machine where Varians answers for your own proxy (default 3000).
# VARIANS_PORT=3000
