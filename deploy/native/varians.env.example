# Settings of a native Varians installation, kept at /etc/varians/varians.env
# (owner root, group varians, mode 640; never in git). The systemd units read
# it, and so does `bin/varians` when DATABASE_URL is not set otherwise.
# docs/install.md explains each setting. Quote a value that contains spaces
# or < >, as MAIL_FROM below.

# The database through PostgreSQL's socket on the same machine. The system
# user varians is let in as the database user varians without a password (peer).
DATABASE_URL=postgresql://varians@/varians?host=/run/postgresql

# The public address of the site.
ORIGIN=https://editions.example.org

# The installation's name, used in mail, citations and package metadata.
SITE_NAME=Varians

# The licence of published scholarly records: CC-BY-SA-4.0, CC-BY-4.0 or CC0-1.0.
DATA_LICENCE=CC-BY-SA-4.0

# Mail over SMTP; empty to run without mail (see docs/install.md).
SMTP_URL=
MAIL_FROM="Varians <noreply@editions.example.org>"

# Set by the unit; change here only if you must:
# STORAGE_DIR=/var/lib/varians/storage
# BACKUP_DIR=/var/lib/varians/backups
# BACKUP_KEEP=14
# PORT=3000
# ARCHIVE_INTERVAL_HOURS=24
# SOURCE_URL=https://example.org/your/varians
