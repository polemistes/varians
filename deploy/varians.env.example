# Settings of a Varians installation, kept at /home/varians/varians.env (never in git).

# The database through PostgreSQL's socket on the same server. The Linux user
# varians is let in as the database user varians without a password (peer).
DATABASE_URL=postgresql://varians@/varians?host=/run/postgresql

# Uploaded images, tiles and the archives (git repositories, one per work).
STORAGE_DIR=/home/varians/storage

# The public address of the site, used in links and permalinks.
ORIGIN=https://varians.eu

# Optional: hours between the archive passes (default 24), or ARCHIVE_SCHEDULER=off to stop them.
# ARCHIVE_INTERVAL_HOURS=24
# Optional: seconds a record must be left alone before its archive files are rewritten (default 60).
# ARCHIVE_WRITE_DELAY_SECONDS=60

# The licence of published records (default CC-BY-SA-4.0) and the installation's name (default Varians).
# DATA_LICENCE=CC-BY-SA-4.0
# SITE_NAME=Varians
# Encrypts the tokens of other installations kept for pulling and pushing works; a long random string.
# SECRET_KEY=
