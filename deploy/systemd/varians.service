# Varians as a service: one Node process, listening only on the server itself
# (127.0.0.1:3000); Apache passes the public site's requests on to it.
# Install: cp to /etc/systemd/system/, then systemctl daemon-reload.

[Unit]
Description=Varians (digital scholarly editions)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=varians
Group=varians
WorkingDirectory=/home/varians/app/apps/web
EnvironmentFile=/home/varians/varians.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
# Uploads of up to 100 MB (images, archives).
Environment=BODY_SIZE_LIMIT=104857600
# Apache adds the visitor's address to X-Forwarded-For; the limits on logins and registrations count by it.
Environment=ADDRESS_HEADER=X-Forwarded-For
Environment=XFF_DEPTH=1
ExecStart=/usr/bin/node build/index.js
Restart=on-failure
RestartSec=3

# A fence round the process: the system is read-only to it, other people's
# homes are hidden, and it sees only the current release (read-only) and its
# storage (read-write).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/varians/app
BindPaths=/home/varians/storage

[Install]
WantedBy=multi-user.target
