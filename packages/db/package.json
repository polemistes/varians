{
  "name": "@varians/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The PostgreSQL schema of Varians, with Drizzle.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
