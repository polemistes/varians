      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDB">μῆνιν</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDC">ἄειδε</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDD">θεὰ</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDE">Πηληϊάδεω</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDF">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDH">οὐλομένην,</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDJ">ἣ</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDK">μυρί᾽</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDM">Ἀχαιοῖς</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDN">ἄλγε᾽</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDP">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDR">ἡρώων,</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDS">αὐτοὺς</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDT">δὲ</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDV">ἑλώρια</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDW">τεῦχε</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDX">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M71ZVR7VJAW55V4QZB59AQDZ">οἰωνοῖσί</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQE0">τε</w> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQE1">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M71ZVR7VJAW55V4QZB59AQE4">ἐτελείετο</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJ9Z">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJA1">Ἀτρεΐδης</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJA2">τε</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJA3">ἄναξ</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJA4">ἀνδρῶν</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJA5">καὶ</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJA6">δῖος</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJA7">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJA9">τίς</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAA">τ᾽</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAB">ἄρ</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAC">σφωε</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAD">θεῶν</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAE">ἔριδι</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAF">ξυνέηκε</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAG">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAJ">Λητοῦς</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAK">καὶ</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAM">Διὸς</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAN">υἱός·</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAP">ὁ</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAQ">γὰρ</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAR">βασιλῆϊ</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAS">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAV">νοῦσον</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAW">ἀνὰ</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAX">στρατὸν</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAY">ὄρσε</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJAZ">κακά,</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJB0">ὀλέκοντο</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJB1">δὲ</w> <w xml:id="w-01M71ZVR7WH68SD0D6JD1WGJB2">λαοί,</w></ab>
    </body>
