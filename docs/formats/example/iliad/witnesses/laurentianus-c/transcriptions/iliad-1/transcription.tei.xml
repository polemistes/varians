      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7Z0">μῆνιν</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7Z1">ἄειδε</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7Z2">θεὰ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7Z3">Πηληϊάδεω</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7Z4">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7Z6">οὐλομένην,</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7Z7">ἣ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7Z8">μυρί᾽</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7Z9">Ἀχαιοῖς</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZA">ἄλγε᾽</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZB">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZD">ἡρώων,</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZE">αὐτοὺς</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZF">δὲ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZG">ἑλώρια</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZH">τεῦχε</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZJ">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZM">οἰωνοῖσί</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZN">τε</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZP">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZS">ἐτελείετο</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZT">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZW">Ἀτρεΐδης</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZX">τε</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZY">ἄναξ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H7ZZ">ἀνδρῶν</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H800">καὶ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H801">δῖος</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H802">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H804">τίς</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H805">τ᾽</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H806">ἄρ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H807">σφωε</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H808">θεῶν</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H809">ἔριδι</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80A">ξυνέηκε</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80B">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80D">Λητοῦς</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80E">καὶ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80F">Διὸς</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80G">υἱός·</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80H">ὁ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80J">γὰρ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80K">βασιλῆϊ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80M">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80P">νοῦσον</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80Q">ἀνὰ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80R">στρατὸν</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80S">ὄρσε</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80T">κακά,</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80V">ὀλέκοντο</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80W">δὲ</w> <w xml:id="w-01M73A3Y0XAZ2XZ4M3ACM5H80X">λαοί,</w></ab>
    </body>
