      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8W2">μῆνιν</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8W3">ἄειδε</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8W4">θεὰ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8W5">Πηληϊάδεω</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8W6">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8W8">οὐλομένην,</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8W9">ἣ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WA">μυρί᾽</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WB">Ἀχαιοῖς</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WC">ἄλγε᾽</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WD">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WF">ἡρώων,</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WG">αὐτοὺς</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WH">δὲ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WJ">ἑλώρια</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WK">τεῦχε</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WM">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WP">οἰωνοῖσί</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WQ">τε</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WR">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WV">ἐτελείετο</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WW">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WY">Ἀτρεΐδης</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8WZ">τε</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8X0">ἄναξ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8X1">ἀνδρῶν</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8X2">καὶ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8X3">δῖος</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8X4">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8X6">τίς</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8X7">τ᾽</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8X8">ἄρ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8X9">σφωε</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XA">θεῶν</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XB">ἔριδι</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XC">ξυνέηκε</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XD">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XF">Λητοῦς</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XG">καὶ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XH">Διὸς</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XJ">υἱός·</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XK">ὁ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XM">γὰρ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XN">βασιλῆϊ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XP">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XR">νοῦσον</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XS">ἀνὰ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XT">στρατὸν</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XV">ὄρσε</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XW">κακά,</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XX">ὀλέκοντο</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XY">δὲ</w> <w xml:id="w-01M6Z8YE5AHFBZ38T827WXC8XZ">λαοί,</w></ab>
    </body>
