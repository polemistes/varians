      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTH">μῆνιν</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTJ">ἄειδε</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTK">θεὰ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTM">Πηληϊάδεω</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTN">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTQ">οὐλομένην,</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTR">ἣ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTS">μυρί᾽</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTT">Ἀχαιοῖς</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTV">ἄλγε᾽</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTW">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTY">ἡρώων,</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FTZ">αὐτοὺς</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FV0">δὲ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FV1">ἑλώρια</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FV2">τεῦχε</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FV3">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FV5">οἰωνοῖσί</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FV6">τε</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FV7">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVA">ἐτελείετο</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVB">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVD">Ἀτρεΐδης</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVE">τε</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVF">ἄναξ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVG">ἀνδρῶν</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVH">καὶ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVJ">δῖος</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVK">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVN">τίς</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVP">τ᾽</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVQ">ἄρ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVR">σφωε</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVS">θεῶν</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVT">ἔριδι</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVV">ξυνέηκε</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVW">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVY">Λητοῦς</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FVZ">καὶ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FW0">Διὸς</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FW1">υἱός·</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FW2">ὁ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FW3">γὰρ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FW4">βασιλῆϊ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FW5">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FW7">νοῦσον</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FW8">ἀνὰ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FW9">στρατὸν</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FWA">ὄρσε</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FWB">κακά,</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FWC">ὀλέκοντο</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FWD">δὲ</w> <w xml:id="w-01M71YF5N7C1CMYG5HMKBT1FWE">λαοί,</w></ab>
    </body>
