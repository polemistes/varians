      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M72GA7M748SSG8PGX6FQ46QH">μῆνιν</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46QJ">ἄειδε</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46QK">θεὰ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46QM">Πηληϊάδεω</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46QN">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M72GA7M748SSG8PGX6FQ46QQ">οὐλομένην,</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46QR">ἣ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46QS">μυρί᾽</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46QT">Ἀχαιοῖς</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46QV">ἄλγε᾽</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46QW">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M72GA7M748SSG8PGX6FQ46QY">ἡρώων,</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46QZ">αὐτοὺς</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46R0">δὲ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46R1">ἑλώρια</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46R2">τεῦχε</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46R3">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M72GA7M748SSG8PGX6FQ46R5">οἰωνοῖσί</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46R6">τε</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46R7">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RA">ἐτελείετο</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RB">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M72GA7M748SSG8PGX6FQ46RD">Ἀτρεΐδης</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RE">τε</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RF">ἄναξ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RG">ἀνδρῶν</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RH">καὶ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RJ">δῖος</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RK">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M72GA7M748SSG8PGX6FQ46RN">τίς</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RP">τ᾽</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RQ">ἄρ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RR">σφωε</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RS">θεῶν</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RT">ἔριδι</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RV">ξυνέηκε</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RW">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M72GA7M748SSG8PGX6FQ46RY">Λητοῦς</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46RZ">καὶ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46S0">Διὸς</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46S1">υἱός·</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46S2">ὁ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46S3">γὰρ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46S4">βασιλῆϊ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46S5">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M72GA7M748SSG8PGX6FQ46S7">νοῦσον</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46S8">ἀνὰ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46S9">στρατὸν</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46SA">ὄρσε</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46SB">κακά,</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46SC">ὀλέκοντο</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46SD">δὲ</w> <w xml:id="w-01M72GA7M748SSG8PGX6FQ46SE">λαοί,</w></ab>
