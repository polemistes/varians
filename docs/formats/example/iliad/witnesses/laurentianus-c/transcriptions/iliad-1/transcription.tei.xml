      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M74DME7BQSQBJQ1E0M35FDK8">μῆνιν</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDK9">ἄειδε</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKA">θεὰ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKB">Πηληϊάδεω</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKC">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKE">οὐλομένην,</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKF">ἣ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKG">μυρί᾽</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKH">Ἀχαιοῖς</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKJ">ἄλγε᾽</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKK">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKN">ἡρώων,</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKP">αὐτοὺς</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKQ">δὲ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKR">ἑλώρια</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKS">τεῦχε</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKT">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKW">οἰωνοῖσί</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKX">τε</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDKY">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDM1">ἐτελείετο</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDM2">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M74DME7BQSQBJQ1E0M35FDM4">Ἀτρεΐδης</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDM5">τε</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDM6">ἄναξ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDM7">ἀνδρῶν</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDM8">καὶ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDM9">δῖος</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMA">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMC">τίς</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMD">τ᾽</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDME">ἄρ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMF">σφωε</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMG">θεῶν</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMH">ἔριδι</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMJ">ξυνέηκε</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMK">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMN">Λητοῦς</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMP">καὶ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMQ">Διὸς</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMR">υἱός·</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMS">ὁ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMT">γὰρ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMV">βασιλῆϊ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMW">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMY">νοῦσον</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDMZ">ἀνὰ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDN0">στρατὸν</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDN1">ὄρσε</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDN2">κακά,</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDN3">ὀλέκοντο</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDN4">δὲ</w> <w xml:id="w-01M74DME7BQSQBJQ1E0M35FDN5">λαοί,</w></ab>
