      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1D">μῆνιν</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1E">ἄειδε</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1F">θεὰ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1G">Πηληϊάδεω</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1H">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1K">οὐλομένην,</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1M">ἣ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1N">μυρί᾽</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1P">Ἀχαιοῖς</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1Q">ἄλγε᾽</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1R">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1T">ἡρώων,</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1V">αὐτοὺς</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1W">δὲ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1X">ἑλώρια</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1Y">τεῦχε</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ1Z">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ21">οἰωνοῖσί</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ22">τε</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ23">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ26">ἐτελείετο</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ27">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ29">Ἀτρεΐδης</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2A">τε</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2B">ἄναξ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2C">ἀνδρῶν</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2D">καὶ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2E">δῖος</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2F">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2H">τίς</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2J">τ᾽</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2K">ἄρ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2M">σφωε</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2N">θεῶν</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2P">ἔριδι</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2Q">ξυνέηκε</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2R">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2T">Λητοῦς</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2V">καὶ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2W">Διὸς</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2X">υἱός·</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2Y">ὁ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ2Z">γὰρ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ30">βασιλῆϊ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ31">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ33">νοῦσον</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ34">ἀνὰ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ35">στρατὸν</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ36">ὄρσε</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ37">κακά,</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ38">ὀλέκοντο</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ39">δὲ</w> <w xml:id="w-01M77HWS8XWEE8PDWWRSXKDJ3A">λαοί,</w></ab>
