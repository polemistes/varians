      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M7273QFVCPXH42G8WGS7DSP8">μῆνιν</w> <w xml:id="w-01M7273QFVCPXH42G8WGS7DSP9">ἄειδε</w> <w xml:id="w-01M7273QFVCPXH42G8WGS7DSPA">θεὰ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6AN">Πηληϊάδεω</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6AP">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M7273QFW7MZMC2PY77H3C6AR">οὐλομένην,</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6AS">ἣ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6AT">μυρί᾽</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6AV">Ἀχαιοῖς</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6AW">ἄλγε᾽</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6AX">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M7273QFW7MZMC2PY77H3C6AZ">ἡρώων,</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6B0">αὐτοὺς</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6B1">δὲ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6B2">ἑλώρια</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6B3">τεῦχε</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6B4">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M7273QFW7MZMC2PY77H3C6B6">οἰωνοῖσί</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6B7">τε</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6B8">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BB">ἐτελείετο</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BC">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M7273QFW7MZMC2PY77H3C6BE">Ἀτρεΐδης</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BF">τε</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BG">ἄναξ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BH">ἀνδρῶν</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BJ">καὶ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BK">δῖος</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BM">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M7273QFW7MZMC2PY77H3C6BP">τίς</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BQ">τ᾽</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BR">ἄρ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BS">σφωε</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BT">θεῶν</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BV">ἔριδι</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BW">ξυνέηκε</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6BX">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M7273QFW7MZMC2PY77H3C6BZ">Λητοῦς</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6C0">καὶ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6C1">Διὸς</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6C2">υἱός·</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6C3">ὁ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6C4">γὰρ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6C5">βασιλῆϊ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6C6">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M7273QFW7MZMC2PY77H3C6C8">νοῦσον</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6C9">ἀνὰ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6CA">στρατὸν</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6CB">ὄρσε</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6CC">κακά,</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6CD">ὀλέκοντο</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6CE">δὲ</w> <w xml:id="w-01M7273QFW7MZMC2PY77H3C6CF">λαοί,</w></ab>
