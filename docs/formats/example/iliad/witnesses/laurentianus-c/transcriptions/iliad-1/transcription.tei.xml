      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M74M31T9GFDHJC2Q36XKPS31">μῆνιν</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS32">ἄειδε</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS33">θεὰ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS34">Πηληϊάδεω</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS35">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M74M31T9GFDHJC2Q36XKPS37">οὐλομένην,</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS38">ἣ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS39">μυρί᾽</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3A">Ἀχαιοῖς</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3B">ἄλγε᾽</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3C">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3E">ἡρώων,</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3F">αὐτοὺς</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3G">δὲ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3H">ἑλώρια</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3J">τεῦχε</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3K">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3N">οἰωνοῖσί</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3P">τε</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3Q">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3T">ἐτελείετο</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3V">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3X">Ἀτρεΐδης</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3Y">τε</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS3Z">ἄναξ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS40">ἀνδρῶν</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS41">καὶ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS42">δῖος</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS43">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M74M31T9GFDHJC2Q36XKPS45">τίς</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS46">τ᾽</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS47">ἄρ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS48">σφωε</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS49">θεῶν</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4A">ἔριδι</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4B">ξυνέηκε</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4C">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4E">Λητοῦς</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4F">καὶ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4G">Διὸς</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4H">υἱός·</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4J">ὁ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4K">γὰρ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4M">βασιλῆϊ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4N">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4Q">νοῦσον</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4R">ἀνὰ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4S">στρατὸν</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4T">ὄρσε</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4V">κακά,</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4W">ὀλέκοντο</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4X">δὲ</w> <w xml:id="w-01M74M31T9GFDHJC2Q36XKPS4Y">λαοί,</w></ab>
