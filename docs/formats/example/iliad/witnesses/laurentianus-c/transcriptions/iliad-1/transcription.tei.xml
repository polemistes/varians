      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YK0">μῆνιν</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YK1">ἄειδε</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YK2">θεὰ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YK3">Πηληϊάδεω</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YK4">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YK6">οὐλομένην,</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YK7">ἣ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YK8">μυρί᾽</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YK9">Ἀχαιοῖς</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKA">ἄλγε᾽</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKB">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKD">ἡρώων,</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKE">αὐτοὺς</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKF">δὲ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKG">ἑλώρια</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKH">τεῦχε</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKJ">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKM">οἰωνοῖσί</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKN">τε</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKP">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKS">ἐτελείετο</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKT">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKW">Ἀτρεΐδης</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKX">τε</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKY">ἄναξ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YKZ">ἀνδρῶν</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YM0">καὶ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YM1">δῖος</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YM2">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YM4">τίς</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YM5">τ᾽</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YM6">ἄρ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YM7">σφωε</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YM8">θεῶν</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YM9">ἔριδι</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMA">ξυνέηκε</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMB">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMD">Λητοῦς</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YME">καὶ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMF">Διὸς</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMG">υἱός·</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMH">ὁ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMJ">γὰρ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMK">βασιλῆϊ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMM">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMP">νοῦσον</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMQ">ἀνὰ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMR">στρατὸν</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMS">ὄρσε</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMT">κακά,</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMV">ὀλέκοντο</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMW">δὲ</w> <w xml:id="w-01M6Z9Q3ZJFS5AN2Z1TGYA3YMX">λαοί,</w></ab>
    </body>
