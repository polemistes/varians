      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M73MSVVZEF0S9MD75AMYB6KP">μῆνιν</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6KQ">ἄειδε</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6KR">θεὰ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6KS">Πηληϊάδεω</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6KT">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M73MSVVZEF0S9MD75AMYB6KW">οὐλομένην,</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6KX">ἣ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6KY">μυρί᾽</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6KZ">Ἀχαιοῖς</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6M0">ἄλγε᾽</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6M1">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M73MSVVZEF0S9MD75AMYB6M3">ἡρώων,</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6M4">αὐτοὺς</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6M5">δὲ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6M6">ἑλώρια</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6M7">τεῦχε</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6M8">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MA">οἰωνοῖσί</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MB">τε</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MC">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MF">ἐτελείετο</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MG">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MJ">Ἀτρεΐδης</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MK">τε</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MM">ἄναξ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MN">ἀνδρῶν</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MP">καὶ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MQ">δῖος</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MR">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MT">τίς</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MV">τ᾽</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MW">ἄρ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MX">σφωε</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MY">θεῶν</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6MZ">ἔριδι</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6N0">ξυνέηκε</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6N1">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M73MSVVZEF0S9MD75AMYB6N3">Λητοῦς</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6N4">καὶ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6N5">Διὸς</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6N6">υἱός·</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6N7">ὁ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6N8">γὰρ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6N9">βασιλῆϊ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6NA">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M73MSVVZEF0S9MD75AMYB6NC">νοῦσον</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6ND">ἀνὰ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6NE">στρατὸν</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6NF">ὄρσε</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6NG">κακά,</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6NH">ὀλέκοντο</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6NJ">δὲ</w> <w xml:id="w-01M73MSVVZEF0S9MD75AMYB6NK">λαοί,</w></ab>
    </body>
