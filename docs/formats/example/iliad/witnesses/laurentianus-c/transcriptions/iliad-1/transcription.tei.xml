      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M74HP0CQZXXZCSCW05KSQQB8">μῆνιν</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQB9">ἄειδε</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBA">θεὰ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBB">Πηληϊάδεω</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBC">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBE">οὐλομένην,</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBF">ἣ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBG">μυρί᾽</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBH">Ἀχαιοῖς</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBJ">ἄλγε᾽</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBK">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBN">ἡρώων,</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBP">αὐτοὺς</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBQ">δὲ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBR">ἑλώρια</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBS">τεῦχε</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBT">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBW">οἰωνοῖσί</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBX">τε</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQBY">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQC1">ἐτελείετο</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQC2">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M74HP0CQZXXZCSCW05KSQQC4">Ἀτρεΐδης</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQC5">τε</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQC6">ἄναξ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQC7">ἀνδρῶν</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQC8">καὶ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQC9">δῖος</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCA">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCC">τίς</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCD">τ᾽</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCE">ἄρ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCF">σφωε</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCG">θεῶν</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCH">ἔριδι</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCJ">ξυνέηκε</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCK">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCN">Λητοῦς</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCP">καὶ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCQ">Διὸς</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCR">υἱός·</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCS">ὁ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCT">γὰρ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCV">βασιλῆϊ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCW">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCY">νοῦσον</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQCZ">ἀνὰ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQD0">στρατὸν</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQD1">ὄρσε</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQD2">κακά,</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQD3">ὀλέκοντο</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQD4">δὲ</w> <w xml:id="w-01M74HP0CQZXXZCSCW05KSQQD5">λαοί,</w></ab>
