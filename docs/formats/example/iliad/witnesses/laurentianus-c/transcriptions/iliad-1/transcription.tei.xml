      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M72HG8470DR3FEWV7QZEXCTF">μῆνιν</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTG">ἄειδε</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTH">θεὰ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTJ">Πηληϊάδεω</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTK">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M72HG8470DR3FEWV7QZEXCTN">οὐλομένην,</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTP">ἣ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTQ">μυρί᾽</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTR">Ἀχαιοῖς</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTS">ἄλγε᾽</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTT">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M72HG8470DR3FEWV7QZEXCTW">ἡρώων,</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTX">αὐτοὺς</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTY">δὲ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCTZ">ἑλώρια</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCV0">τεῦχε</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCV1">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M72HG8470DR3FEWV7QZEXCV3">οἰωνοῖσί</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCV4">τε</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCV5">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCV8">ἐτελείετο</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCV9">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M72HG8470DR3FEWV7QZEXCVB">Ἀτρεΐδης</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVC">τε</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVD">ἄναξ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVE">ἀνδρῶν</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVF">καὶ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVG">δῖος</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVH">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M72HG8470DR3FEWV7QZEXCVK">τίς</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVM">τ᾽</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVN">ἄρ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVP">σφωε</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVQ">θεῶν</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVR">ἔριδι</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVS">ξυνέηκε</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVT">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M72HG8470DR3FEWV7QZEXCVW">Λητοῦς</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVX">καὶ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVY">Διὸς</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCVZ">υἱός·</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCW0">ὁ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCW1">γὰρ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCW2">βασιλῆϊ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCW3">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M72HG8470DR3FEWV7QZEXCW5">νοῦσον</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCW6">ἀνὰ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCW7">στρατὸν</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCW8">ὄρσε</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCW9">κακά,</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCWA">ὀλέκοντο</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCWB">δὲ</w> <w xml:id="w-01M72HG8470DR3FEWV7QZEXCWC">λαοί,</w></ab>
