      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKV9">μῆνιν</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVA">ἄειδε</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVB">θεὰ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVC">Πηληϊάδεω</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVD">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVF">οὐλομένην,</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVG">ἣ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVH">μυρί᾽</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVJ">Ἀχαιοῖς</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVK">ἄλγε᾽</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVM">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVP">ἡρώων,</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVQ">αὐτοὺς</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVR">δὲ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVS">ἑλώρια</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVT">τεῦχε</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVV">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVX">οἰωνοῖσί</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVY">τε</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKVZ">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKW2">ἐτελείετο</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKW3">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKW5">Ἀτρεΐδης</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKW6">τε</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKW7">ἄναξ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKW8">ἀνδρῶν</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKW9">καὶ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWA">δῖος</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWB">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWD">τίς</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWE">τ᾽</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWF">ἄρ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWG">σφωε</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWH">θεῶν</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWJ">ἔριδι</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWK">ξυνέηκε</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWM">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWP">Λητοῦς</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWQ">καὶ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWR">Διὸς</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWS">υἱός·</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWT">ὁ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWV">γὰρ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWW">βασιλῆϊ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWX">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKWZ">νοῦσον</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKX0">ἀνὰ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKX1">στρατὸν</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKX2">ὄρσε</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKX3">κακά,</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKX4">ὀλέκοντο</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKX5">δὲ</w> <w xml:id="w-01M72TX5G4EBJYV5MBBP8MVKX6">λαοί,</w></ab>
