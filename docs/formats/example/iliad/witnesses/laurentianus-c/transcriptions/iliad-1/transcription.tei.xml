      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSC">μῆνιν</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSD">ἄειδε</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSE">θεὰ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSF">Πηληϊάδεω</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSG">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSJ">οὐλομένην,</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSK">ἣ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSM">μυρί᾽</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSN">Ἀχαιοῖς</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSP">ἄλγε᾽</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSQ">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSS">ἡρώων,</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SST">αὐτοὺς</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSV">δὲ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSW">ἑλώρια</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSX">τεῦχε</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SSY">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M74KBWW7QTR6YN3RE5AN7ST0">οἰωνοῖσί</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7ST1">τε</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7ST2">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7ST5">ἐτελείετο</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7ST6">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M74KBWW7QTR6YN3RE5AN7ST8">Ἀτρεΐδης</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7ST9">τε</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STA">ἄναξ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STB">ἀνδρῶν</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STC">καὶ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STD">δῖος</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STE">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STG">τίς</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STH">τ᾽</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STJ">ἄρ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STK">σφωε</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STM">θεῶν</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STN">ἔριδι</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STP">ξυνέηκε</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STQ">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STS">Λητοῦς</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STT">καὶ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STV">Διὸς</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STW">υἱός·</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STX">ὁ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STY">γὰρ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7STZ">βασιλῆϊ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SV0">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SV2">νοῦσον</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SV3">ἀνὰ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SV4">στρατὸν</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SV5">ὄρσε</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SV6">κακά,</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SV7">ὀλέκοντο</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SV8">δὲ</w> <w xml:id="w-01M74KBWW7QTR6YN3RE5AN7SV9">λαοί,</w></ab>
