      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M6ZBS34GW1FR966C6YZVB7QM">μῆνιν</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VG">ἄειδε</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VH">θεὰ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VJ">Πηληϊάδεω</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VK">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VN">οὐλομένην,</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VP">ἣ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VQ">μυρί᾽</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VR">Ἀχαιοῖς</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VS">ἄλγε᾽</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VT">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VW">ἡρώων,</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VX">αὐτοὺς</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VY">δὲ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5VZ">ἑλώρια</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5W0">τεῦχε</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5W1">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M6ZBS34H250C03CDN9KKJ5W3">οἰωνοῖσί</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5W4">τε</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5W5">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5W8">ἐτελείετο</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5W9">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WB">Ἀτρεΐδης</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WC">τε</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WD">ἄναξ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WE">ἀνδρῶν</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WF">καὶ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WG">δῖος</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WH">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WK">τίς</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WM">τ᾽</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WN">ἄρ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WP">σφωε</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WQ">θεῶν</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WR">ἔριδι</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WS">ξυνέηκε</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WT">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WW">Λητοῦς</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WX">καὶ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WY">Διὸς</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5WZ">υἱός·</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5X0">ὁ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5X1">γὰρ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5X2">βασιλῆϊ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5X3">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M6ZBS34H250C03CDN9KKJ5X5">νοῦσον</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5X6">ἀνὰ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5X7">στρατὸν</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5X8">ὄρσε</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5X9">κακά,</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5XA">ὀλέκοντο</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5XB">δὲ</w> <w xml:id="w-01M6ZBS34H250C03CDN9KKJ5XC">λαοί,</w></ab>
    </body>
