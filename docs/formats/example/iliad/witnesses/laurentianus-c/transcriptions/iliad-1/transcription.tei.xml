      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17E8">μῆνιν</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17E9">ἄειδε</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EA">θεὰ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EB">Πηληϊάδεω</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EC">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EE">οὐλομένην,</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EF">ἣ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EG">μυρί᾽</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EH">Ἀχαιοῖς</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EJ">ἄλγε᾽</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EK">ἔθηκε,</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EN">ἡρώων,</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EP">αὐτοὺς</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EQ">δὲ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17ER">ἑλώρια</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17ES">τεῦχε</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17ET">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EW">οἰωνοῖσί</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EX">τε</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17EY">πᾶσι,</w> <gap unit="character" reason="lost" quantity="6"/> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17F1">ἐτελείετο</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17F2">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17F4">Ἀτρεΐδης</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17F5">τε</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17F6">ἄναξ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17F7">ἀνδρῶν</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17F8">καὶ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17F9">δῖος</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FA">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FC">τίς</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FD">τ᾽</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FE">ἄρ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FF">σφωε</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FG">θεῶν</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FH">ἔριδι</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FJ">ξυνέηκε</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FK">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FN">Λητοῦς</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FP">καὶ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FQ">Διὸς</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FR">υἱός·</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FS">ὁ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FT">γὰρ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FV">βασιλῆϊ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FW">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FY">νοῦσον</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17FZ">ἀνὰ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17G0">στρατὸν</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17G1">ὄρσε</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17G2">κακά,</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17G3">ὀλέκοντο</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17G4">δὲ</w> <w xml:id="w-01M6Z6P2DH7PPE8PB5RY8H17G5">λαοί,</w></ab>
    </body>
