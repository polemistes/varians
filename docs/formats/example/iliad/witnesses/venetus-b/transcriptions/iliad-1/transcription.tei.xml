      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YK">μῆνιν</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YM">ἄειδε</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YN">θεὰ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YP">Πηληϊάδεω</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YQ">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YS">οὐλομένην,</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YT">ἣ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YV">μυρία</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YW">Ἀχαιοῖς</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YX">ἄλγεα</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2YY">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2Z0">πολλὰς</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2Z1">δ᾽</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2Z2">ἰφθίμους</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2Z3">ψυχὰς</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2Z4">Ἄϊδι</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2Z5">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2Z7">ἡρώων,</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2Z8">αὐτοὺς</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2Z9">δὲ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZA">ἕλωρα</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZB">τεῦχε</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZC">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZE">οἰωνοῖσί</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZF">τε</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZG">πᾶσι,</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZH">Διὸς</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZJ">δ᾽</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZK">ἐτελείετο</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZM">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZP">Ἀτρεΐδης</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZQ">τε</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZR">ἄναξ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZS">ἀνδρῶν</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZT">καὶ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZV">δῖος</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZW">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZY">τίς</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF2ZZ">τ᾽</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF300">ἄρ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF301">σφωε</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF302">θεῶν</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF303">ἔριδι</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF304">συνέηκε</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF305">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF307">Διὸς</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF308">καὶ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF309">Λητοῦς</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30A">υἱός·</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30B">ὁ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30C">γὰρ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30D">βασιλῆϊ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30E">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30G">νοῦσον</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30H">ἀνὰ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30J">στρατὸν</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30K">ὄρσε</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30M">κακήν,</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30N">ὀλέκοντο</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30P">δὲ</w> <w xml:id="w-01M6ZBS33SPMQCXZQBY9WQF30Q">λαοί,</w></ab>
