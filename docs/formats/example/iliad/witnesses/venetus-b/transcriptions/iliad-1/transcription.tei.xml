      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPA">μῆνιν</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPB">ἄειδε</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPC">θεὰ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPD">Πηληϊάδεω</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPE">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPG">οὐλομένην,</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPH">ἣ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPJ">μυρία</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPK">Ἀχαιοῖς</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPM">ἄλγεα</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPN">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPQ">πολλὰς</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPR">δ᾽</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPS">ἰφθίμους</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPT">ψυχὰς</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPV">Ἄϊδι</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPW">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPY">ἡρώων,</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZPZ">αὐτοὺς</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQ0">δὲ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQ1">ἕλωρα</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQ2">τεῦχε</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQ3">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQ5">οἰωνοῖσί</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQ6">τε</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQ7">πᾶσι,</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQ8">Διὸς</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQ9">δ᾽</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQA">ἐτελείετο</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQB">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQD">Ἀτρεΐδης</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQE">τε</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQF">ἄναξ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQG">ἀνδρῶν</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQH">καὶ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQJ">δῖος</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQK">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQN">τίς</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQP">τ᾽</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQQ">ἄρ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQR">σφωε</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQS">θεῶν</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQT">ἔριδι</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQV">συνέηκε</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQW">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQY">Διὸς</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZQZ">καὶ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZR0">Λητοῦς</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZR1">υἱός·</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZR2">ὁ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZR3">γὰρ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZR4">βασιλῆϊ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZR5">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M73MSVV8DBM81GPKKSG89ZR7">νοῦσον</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZR8">ἀνὰ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZR9">στρατὸν</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZRA">ὄρσε</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZRB">κακήν,</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZRC">ὀλέκοντο</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZRD">δὲ</w> <w xml:id="w-01M73MSVV8DBM81GPKKSG89ZRE">λαοί,</w></ab>
    </body>
