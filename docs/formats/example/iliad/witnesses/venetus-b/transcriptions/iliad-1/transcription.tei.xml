    <body>
      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M74DME6TND63F074RZNMS34Y">μῆνιν</w> <w xml:id="w-01M74DME6TND63F074RZNMS34Z">ἄειδε</w> <w xml:id="w-01M74DME6TND63F074RZNMS350">θεὰ</w> <w xml:id="w-01M74DME6TND63F074RZNMS351">Πηληϊάδεω</w> <w xml:id="w-01M74DME6TND63F074RZNMS352">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M74DME6TND63F074RZNMS354">οὐλομένην,</w> <w xml:id="w-01M74DME6TND63F074RZNMS355">ἣ</w> <w xml:id="w-01M74DME6TND63F074RZNMS356">μυρία</w> <w xml:id="w-01M74DME6TND63F074RZNMS357">Ἀχαιοῖς</w> <w xml:id="w-01M74DME6TND63F074RZNMS358">ἄλγεα</w> <w xml:id="w-01M74DME6TND63F074RZNMS359">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M74DME6TND63F074RZNMS35B">πολλὰς</w> <w xml:id="w-01M74DME6TND63F074RZNMS35C">δ᾽</w> <w xml:id="w-01M74DME6TND63F074RZNMS35D">ἰφθίμους</w> <w xml:id="w-01M74DME6TND63F074RZNMS35E">ψυχὰς</w> <w xml:id="w-01M74DME6TND63F074RZNMS35F">Ἄϊδι</w> <w xml:id="w-01M74DME6TND63F074RZNMS35G">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M74DME6TND63F074RZNMS35J">ἡρώων,</w> <w xml:id="w-01M74DME6TND63F074RZNMS35K">αὐτοὺς</w> <w xml:id="w-01M74DME6TND63F074RZNMS35M">δὲ</w> <w xml:id="w-01M74DME6TND63F074RZNMS35N">ἕλωρα</w> <w xml:id="w-01M74DME6TND63F074RZNMS35P">τεῦχε</w> <w xml:id="w-01M74DME6TND63F074RZNMS35Q">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M74DME6TND63F074RZNMS35S">οἰωνοῖσί</w> <w xml:id="w-01M74DME6TND63F074RZNMS35T">τε</w> <w xml:id="w-01M74DME6TND63F074RZNMS35V">πᾶσι,</w> <w xml:id="w-01M74DME6TND63F074RZNMS35W">Διὸς</w> <w xml:id="w-01M74DME6TND63F074RZNMS35X">δ᾽</w> <w xml:id="w-01M74DME6TND63F074RZNMS35Y">ἐτελείετο</w> <w xml:id="w-01M74DME6TND63F074RZNMS35Z">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M74DME6TND63F074RZNMS361">Ἀτρεΐδης</w> <w xml:id="w-01M74DME6TND63F074RZNMS362">τε</w> <w xml:id="w-01M74DME6TND63F074RZNMS363">ἄναξ</w> <w xml:id="w-01M74DME6TND63F074RZNMS364">ἀνδρῶν</w> <w xml:id="w-01M74DME6TND63F074RZNMS365">καὶ</w> <w xml:id="w-01M74DME6TND63F074RZNMS366">δῖος</w> <w xml:id="w-01M74DME6TND63F074RZNMS367">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M74DME6TND63F074RZNMS369">τίς</w> <w xml:id="w-01M74DME6TND63F074RZNMS36A">τ᾽</w> <w xml:id="w-01M74DME6TND63F074RZNMS36B">ἄρ</w> <w xml:id="w-01M74DME6TND63F074RZNMS36C">σφωε</w> <w xml:id="w-01M74DME6TND63F074RZNMS36D">θεῶν</w> <w xml:id="w-01M74DME6TND63F074RZNMS36E">ἔριδι</w> <w xml:id="w-01M74DME6TND63F074RZNMS36F">συνέηκε</w> <w xml:id="w-01M74DME6TND63F074RZNMS36G">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M74DME6TND63F074RZNMS36J">Διὸς</w> <w xml:id="w-01M74DME6TND63F074RZNMS36K">καὶ</w> <w xml:id="w-01M74DME6TND63F074RZNMS36M">Λητοῦς</w> <w xml:id="w-01M74DME6TND63F074RZNMS36N">υἱός·</w> <w xml:id="w-01M74DME6TND63F074RZNMS36P">ὁ</w> <w xml:id="w-01M74DME6TND63F074RZNMS36Q">γὰρ</w> <w xml:id="w-01M74DME6TND63F074RZNMS36R">βασιλῆϊ</w> <w xml:id="w-01M74DME6TND63F074RZNMS36S">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M74DME6TND63F074RZNMS36V">νοῦσον</w> <w xml:id="w-01M74DME6TND63F074RZNMS36W">ἀνὰ</w> <w xml:id="w-01M74DME6TND63F074RZNMS36X">στρατὸν</w> <w xml:id="w-01M74DME6TND63F074RZNMS36Y">ὄρσε</w> <w xml:id="w-01M74DME6TND63F074RZNMS36Z">κακήν,</w> <w xml:id="w-01M74DME6TND63F074RZNMS370">ὀλέκοντο</w> <w xml:id="w-01M74DME6TND63F074RZNMS371">δὲ</w> <w xml:id="w-01M74DME6TND63F074RZNMS372">λαοί,</w></ab>
    </body>
