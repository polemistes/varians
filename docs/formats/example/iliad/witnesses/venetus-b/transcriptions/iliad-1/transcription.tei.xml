      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M77HWS8BPG6F2H3VVKQ2C9VE">μῆνιν</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYF">ἄειδε</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYG">θεὰ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYH">Πηληϊάδεω</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYJ">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYM">οὐλομένην,</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYN">ἣ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYP">μυρία</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYQ">Ἀχαιοῖς</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYR">ἄλγεα</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYS">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYV">πολλὰς</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYW">δ᾽</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYX">ἰφθίμους</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYY">ψυχὰς</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEYZ">Ἄϊδι</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZ0">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZ2">ἡρώων,</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZ3">αὐτοὺς</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZ4">δὲ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZ5">ἕλωρα</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZ6">τεῦχε</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZ7">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZ9">οἰωνοῖσί</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZA">τε</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZB">πᾶσι,</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZC">Διὸς</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZD">δ᾽</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZE">ἐτελείετο</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZF">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZH">Ἀτρεΐδης</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZJ">τε</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZK">ἄναξ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZM">ἀνδρῶν</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZN">καὶ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZP">δῖος</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZQ">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZS">τίς</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZT">τ᾽</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZV">ἄρ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZW">σφωε</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZX">θεῶν</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZY">ἔριδι</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WEZZ">συνέηκε</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF00">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF02">Διὸς</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF03">καὶ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF04">Λητοῦς</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF05">υἱός·</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF06">ὁ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF07">γὰρ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF08">βασιλῆϊ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF09">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF0B">νοῦσον</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF0C">ἀνὰ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF0D">στρατὸν</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF0E">ὄρσε</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF0F">κακήν,</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF0G">ὀλέκοντο</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF0H">δὲ</w> <w xml:id="w-01M77HWS8CMCY6X7C5MVQ5WF0J">λαοί,</w></ab>
