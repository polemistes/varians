      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ4F">μῆνιν</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ4G">ἄειδε</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ4H">θεὰ</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ4J">Πηληϊάδεω</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ4K">Ἀχιλῆος</w>
