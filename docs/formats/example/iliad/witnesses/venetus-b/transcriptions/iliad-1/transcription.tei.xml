      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M74M31SDKCRPJABJQ5ZC5VXF">μῆνιν</w> <w xml:id="w-01M74M31SDKCRPJABJQ5ZC5VXG">ἄειδε</w> <w xml:id="w-01M74M31SDKCRPJABJQ5ZC5VXH">θεὰ</w> <w xml:id="w-01M74M31SDKCRPJABJQ5ZC5VXJ">Πηληϊάδεω</w> <w xml:id="w-01M74M31SDKCRPJABJQ5ZC5VXK">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M74M31SEVWMVR45T2CVDZ0WY">οὐλομένην,</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0WZ">ἣ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0X0">μυρία</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0X1">Ἀχαιοῖς</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0X2">ἄλγεα</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0X3">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M74M31SEVWMVR45T2CVDZ0X5">πολλὰς</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0X6">δ᾽</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0X7">ἰφθίμους</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0X8">ψυχὰς</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0X9">Ἄϊδι</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XA">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XC">ἡρώων,</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XD">αὐτοὺς</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XE">δὲ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XF">ἕλωρα</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XG">τεῦχε</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XH">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XK">οἰωνοῖσί</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XM">τε</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XN">πᾶσι,</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XP">Διὸς</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XQ">δ᾽</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XR">ἐτελείετο</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XS">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XV">Ἀτρεΐδης</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XW">τε</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XX">ἄναξ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XY">ἀνδρῶν</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0XZ">καὶ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0Y0">δῖος</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0Y1">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M74M31SEVWMVR45T2CVDZ0Y3">τίς</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0Y4">τ᾽</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0Y5">ἄρ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0Y6">σφωε</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0Y7">θεῶν</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0Y8">ἔριδι</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0Y9">συνέηκε</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YA">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YC">Διὸς</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YD">καὶ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YE">Λητοῦς</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YF">υἱός·</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YG">ὁ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YH">γὰρ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YJ">βασιλῆϊ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YK">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YN">νοῦσον</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YP">ἀνὰ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YQ">στρατὸν</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YR">ὄρσε</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YS">κακήν,</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YT">ὀλέκοντο</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YV">δὲ</w> <w xml:id="w-01M74M31SEVWMVR45T2CVDZ0YW">λαοί,</w></ab>
