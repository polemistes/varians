      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M72HG83KJKCDVC9XZJM20DHR">μῆνιν</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DHS">ἄειδε</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DHT">θεὰ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DHV">Πηληϊάδεω</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DHW">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M72HG83KJKCDVC9XZJM20DHY">οὐλομένην,</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DHZ">ἣ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJ0">μυρία</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJ1">Ἀχαιοῖς</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJ2">ἄλγεα</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJ3">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M72HG83KJKCDVC9XZJM20DJ5">πολλὰς</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJ6">δ᾽</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJ7">ἰφθίμους</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJ8">ψυχὰς</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJ9">Ἄϊδι</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJA">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M72HG83KJKCDVC9XZJM20DJC">ἡρώων,</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJD">αὐτοὺς</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJE">δὲ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJF">ἕλωρα</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJG">τεῦχε</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJH">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M72HG83KJKCDVC9XZJM20DJK">οἰωνοῖσί</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJM">τε</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJN">πᾶσι,</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJP">Διὸς</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJQ">δ᾽</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJR">ἐτελείετο</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJS">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M72HG83KJKCDVC9XZJM20DJV">Ἀτρεΐδης</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJW">τε</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJX">ἄναξ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJY">ἀνδρῶν</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DJZ">καὶ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DK0">δῖος</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DK1">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M72HG83KJKCDVC9XZJM20DK3">τίς</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DK4">τ᾽</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DK5">ἄρ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DK6">σφωε</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DK7">θεῶν</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DK8">ἔριδι</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DK9">συνέηκε</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKA">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M72HG83KJKCDVC9XZJM20DKC">Διὸς</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKD">καὶ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKE">Λητοῦς</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKF">υἱός·</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKG">ὁ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKH">γὰρ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKJ">βασιλῆϊ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKK">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M72HG83KJKCDVC9XZJM20DKN">νοῦσον</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKP">ἀνὰ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKQ">στρατὸν</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKR">ὄρσε</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKS">κακήν,</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKT">ὀλέκοντο</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKV">δὲ</w> <w xml:id="w-01M72HG83KJKCDVC9XZJM20DKW">λαοί,</w></ab>
    </body>
