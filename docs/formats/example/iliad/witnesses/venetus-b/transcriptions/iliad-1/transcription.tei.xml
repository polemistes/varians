      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KCN">μῆνιν</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KCP">ἄειδε</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KCQ">θεὰ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KCR">Πηληϊάδεω</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KCS">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KCV">οὐλομένην,</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KCW">ἣ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KCX">μυρία</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KCY">Ἀχαιοῖς</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KCZ">ἄλγεα</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KD0">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KD2">πολλὰς</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KD3">δ᾽</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KD4">ἰφθίμους</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KD5">ψυχὰς</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KD6">Ἄϊδι</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KD7">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KD9">ἡρώων,</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDA">αὐτοὺς</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDB">δὲ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDC">ἕλωρα</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDD">τεῦχε</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDE">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDG">οἰωνοῖσί</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDH">τε</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDJ">πᾶσι,</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDK">Διὸς</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDM">δ᾽</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDN">ἐτελείετο</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDP">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDR">Ἀτρεΐδης</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDS">τε</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDT">ἄναξ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDV">ἀνδρῶν</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDW">καὶ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDX">δῖος</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KDY">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KE0">τίς</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KE1">τ᾽</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KE2">ἄρ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KE3">σφωε</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KE4">θεῶν</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KE5">ἔριδι</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KE6">συνέηκε</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KE7">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KE9">Διὸς</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEA">καὶ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEB">Λητοῦς</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEC">υἱός·</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KED">ὁ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEE">γὰρ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEF">βασιλῆϊ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEG">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEJ">νοῦσον</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEK">ἀνὰ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEM">στρατὸν</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEN">ὄρσε</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEP">κακήν,</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KEQ">ὀλέκοντο</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KER">δὲ</w> <w xml:id="w-01M6Z6P2CZEQ6Y7CY5HY8E9KES">λαοί,</w></ab>
