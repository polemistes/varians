      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9K">μῆνιν</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9M">ἄειδε</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9N">θεὰ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9P">Πηληϊάδεω</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9Q">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9S">οὐλομένην,</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9T">ἣ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9V">μυρία</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9W">Ἀχαιοῖς</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9X">ἄλγεα</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91E9Y">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EA0">πολλὰς</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EA1">δ᾽</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EA2">ἰφθίμους</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EA3">ψυχὰς</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EA4">Ἄϊδι</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EA5">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EA7">ἡρώων,</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EA8">αὐτοὺς</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EA9">δὲ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAA">ἕλωρα</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAB">τεῦχε</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAC">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAE">οἰωνοῖσί</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAF">τε</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAG">πᾶσι,</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAH">Διὸς</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAJ">δ᾽</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAK">ἐτελείετο</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAM">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAP">Ἀτρεΐδης</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAQ">τε</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAR">ἄναξ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAS">ἀνδρῶν</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAT">καὶ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAV">δῖος</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAW">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAY">τίς</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EAZ">τ᾽</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EB0">ἄρ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EB1">σφωε</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EB2">θεῶν</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EB3">ἔριδι</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EB4">συνέηκε</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EB5">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EB7">Διὸς</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EB8">καὶ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EB9">Λητοῦς</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBA">υἱός·</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBB">ὁ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBC">γὰρ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBD">βασιλῆϊ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBE">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBG">νοῦσον</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBH">ἀνὰ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBJ">στρατὸν</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBK">ὄρσε</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBM">κακήν,</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBN">ὀλέκοντο</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBP">δὲ</w> <w xml:id="w-01M6Z8YE4QCYVDVJ0K93X91EBQ">λαοί,</w></ab>
