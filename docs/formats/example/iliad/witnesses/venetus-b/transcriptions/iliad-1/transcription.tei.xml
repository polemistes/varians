      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HFR">μῆνιν</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HFS">ἄειδε</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HFT">θεὰ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HFV">Πηληϊάδεω</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HFW">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HFY">οὐλομένην,</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HFZ">ἣ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HG0">μυρία</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HG1">Ἀχαιοῖς</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HG2">ἄλγεα</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HG3">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HG5">πολλὰς</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HG6">δ᾽</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HG7">ἰφθίμους</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HG8">ψυχὰς</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HG9">Ἄϊδι</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGA">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGC">ἡρώων,</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGD">αὐτοὺς</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGE">δὲ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGF">ἕλωρα</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGG">τεῦχε</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGH">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGK">οἰωνοῖσί</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGM">τε</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGN">πᾶσι,</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGP">Διὸς</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGQ">δ᾽</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGR">ἐτελείετο</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGS">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGV">Ἀτρεΐδης</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGW">τε</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGX">ἄναξ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGY">ἀνδρῶν</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HGZ">καὶ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HH0">δῖος</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HH1">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HH3">τίς</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HH4">τ᾽</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HH5">ἄρ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HH6">σφωε</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HH7">θεῶν</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HH8">ἔριδι</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HH9">συνέηκε</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHA">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHC">Διὸς</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHD">καὶ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHE">Λητοῦς</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHF">υἱός·</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHG">ὁ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHH">γὰρ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHJ">βασιλῆϊ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHK">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHN">νοῦσον</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHP">ἀνὰ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHQ">στρατὸν</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHR">ὄρσε</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHS">κακήν,</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHT">ὀλέκοντο</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHV">δὲ</w> <w xml:id="w-01M6Z9Q3YXM4XXFHA1CPM60HHW">λαοί,</w></ab>
    </body>
