      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M7273QF610DH9NXJ60K2N3S6">μῆνιν</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3S7">ἄειδε</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3S8">θεὰ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3S9">Πηληϊάδεω</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SA">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M7273QF610DH9NXJ60K2N3SC">οὐλομένην,</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SD">ἣ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SE">μυρία</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SF">Ἀχαιοῖς</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SG">ἄλγεα</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SH">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M7273QF610DH9NXJ60K2N3SK">πολλὰς</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SM">δ᾽</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SN">ἰφθίμους</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SP">ψυχὰς</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SQ">Ἄϊδι</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SR">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M7273QF610DH9NXJ60K2N3ST">ἡρώων,</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SV">αὐτοὺς</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SW">δὲ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SX">ἕλωρα</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SY">τεῦχε</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3SZ">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M7273QF610DH9NXJ60K2N3T1">οἰωνοῖσί</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3T2">τε</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3T3">πᾶσι,</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3T4">Διὸς</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3T5">δ᾽</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3T6">ἐτελείετο</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3T7">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M7273QF610DH9NXJ60K2N3T9">Ἀτρεΐδης</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TA">τε</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TB">ἄναξ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TC">ἀνδρῶν</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TD">καὶ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TE">δῖος</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TF">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M7273QF610DH9NXJ60K2N3TH">τίς</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TJ">τ᾽</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TK">ἄρ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TM">σφωε</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TN">θεῶν</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TP">ἔριδι</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TQ">συνέηκε</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TR">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M7273QF610DH9NXJ60K2N3TT">Διὸς</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TV">καὶ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TW">Λητοῦς</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TX">υἱός·</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TY">ὁ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3TZ">γὰρ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3V0">βασιλῆϊ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3V1">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M7273QF610DH9NXJ60K2N3V3">νοῦσον</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3V4">ἀνὰ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3V5">στρατὸν</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3V6">ὄρσε</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3V7">κακήν,</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3V8">ὀλέκοντο</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3V9">δὲ</w> <w xml:id="w-01M7273QF610DH9NXJ60K2N3VA">λαοί,</w></ab>
    </body>
