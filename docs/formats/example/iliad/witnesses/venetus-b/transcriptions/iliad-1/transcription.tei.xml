      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1B">μῆνιν</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1C">ἄειδε</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1D">θεὰ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1E">Πηληϊάδεω</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1F">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1H">οὐλομένην,</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1J">ἣ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1K">μυρία</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1M">Ἀχαιοῖς</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1N">ἄλγεα</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1P">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1R">πολλὰς</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1S">δ᾽</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1T">ἰφθίμους</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1V">ψυχὰς</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1W">Ἄϊδι</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1X">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M72GA7KM7CA1WX3RFXB43E1Z">ἡρώων,</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E20">αὐτοὺς</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E21">δὲ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E22">ἕλωρα</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E23">τεῦχε</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E24">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M72GA7KM7CA1WX3RFXB43E26">οἰωνοῖσί</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E27">τε</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E28">πᾶσι,</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E29">Διὸς</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2A">δ᾽</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2B">ἐτελείετο</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2C">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2E">Ἀτρεΐδης</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2F">τε</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2G">ἄναξ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2H">ἀνδρῶν</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2J">καὶ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2K">δῖος</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2M">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2P">τίς</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2Q">τ᾽</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2R">ἄρ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2S">σφωε</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2T">θεῶν</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2V">ἔριδι</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2W">συνέηκε</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2X">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M72GA7KM7CA1WX3RFXB43E2Z">Διὸς</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E30">καὶ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E31">Λητοῦς</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E32">υἱός·</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E33">ὁ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E34">γὰρ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E35">βασιλῆϊ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E36">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M72GA7KM7CA1WX3RFXB43E38">νοῦσον</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E39">ἀνὰ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E3A">στρατὸν</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E3B">ὄρσε</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E3C">κακήν,</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E3D">ὀλέκοντο</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E3E">δὲ</w> <w xml:id="w-01M72GA7KM7CA1WX3RFXB43E3F">λαοί,</w></ab>
    </body>
