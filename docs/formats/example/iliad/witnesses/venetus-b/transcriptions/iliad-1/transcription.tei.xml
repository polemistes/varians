      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GK">μῆνιν</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GM">ἄειδε</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GN">θεὰ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GP">Πηληϊάδεω</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GQ">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GS">οὐλομένην,</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GT">ἣ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GV">μυρία</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GW">Ἀχαιοῖς</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GX">ἄλγεα</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67GY">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67H0">πολλὰς</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67H1">δ᾽</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67H2">ἰφθίμους</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67H3">ψυχὰς</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67H4">Ἄϊδι</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67H5">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67H7">ἡρώων,</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67H8">αὐτοὺς</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67H9">δὲ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HA">ἕλωρα</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HB">τεῦχε</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HC">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HE">οἰωνοῖσί</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HF">τε</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HG">πᾶσι,</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HH">Διὸς</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HJ">δ᾽</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HK">ἐτελείετο</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HM">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HP">Ἀτρεΐδης</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HQ">τε</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HR">ἄναξ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HS">ἀνδρῶν</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HT">καὶ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HV">δῖος</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HW">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HY">τίς</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67HZ">τ᾽</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67J0">ἄρ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67J1">σφωε</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67J2">θεῶν</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67J3">ἔριδι</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67J4">συνέηκε</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67J5">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67J7">Διὸς</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67J8">καὶ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67J9">Λητοῦς</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JA">υἱός·</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JB">ὁ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JC">γὰρ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JD">βασιλῆϊ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JE">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JG">νοῦσον</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JH">ἀνὰ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JJ">στρατὸν</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JK">ὄρσε</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JM">κακήν,</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JN">ὀλέκοντο</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JP">δὲ</w> <w xml:id="w-01M73A3Y02MY9ZS35GZ2XF67JQ">λαοί,</w></ab>
