      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57C">μῆνιν</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57D">ἄειδε</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57E">θεὰ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57F">Πηληϊάδεω</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57G">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57J">οὐλομένην,</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57K">ἣ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57M">μυρία</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57N">Ἀχαιοῖς</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57P">ἄλγεα</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57Q">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57S">πολλὰς</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57T">δ᾽</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57V">ἰφθίμους</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57W">ψυχὰς</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57X">Ἄϊδι</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y57Y">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y580">ἡρώων,</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y581">αὐτοὺς</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y582">δὲ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y583">ἕλωρα</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y584">τεῦχε</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y585">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y587">οἰωνοῖσί</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y588">τε</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y589">πᾶσι,</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58A">Διὸς</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58B">δ᾽</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58C">ἐτελείετο</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58D">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58F">Ἀτρεΐδης</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58G">τε</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58H">ἄναξ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58J">ἀνδρῶν</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58K">καὶ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58M">δῖος</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58N">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58Q">τίς</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58R">τ᾽</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58S">ἄρ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58T">σφωε</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58V">θεῶν</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58W">ἔριδι</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58X">συνέηκε</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y58Y">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y590">Διὸς</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y591">καὶ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y592">Λητοῦς</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y593">υἱός·</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y594">ὁ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y595">γὰρ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y596">βασιλῆϊ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y597">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y599">νοῦσον</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y59A">ἀνὰ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y59B">στρατὸν</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y59C">ὄρσε</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y59D">κακήν,</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y59E">ὀλέκοντο</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y59F">δὲ</w> <w xml:id="w-01M71ZVR7APHXWNQN4ZG81Y59G">λαοί,</w></ab>
    </body>
