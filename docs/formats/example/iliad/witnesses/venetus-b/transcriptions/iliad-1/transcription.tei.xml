      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M77QT5CM97BRMZ2AHKSB7PWH">μῆνιν</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMC">ἄειδε</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMD">θεὰ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EME">Πηληϊάδεω</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMF">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMH">οὐλομένην,</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMJ">ἣ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMK">μυρία</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMM">Ἀχαιοῖς</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMN">ἄλγεα</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMP">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMR">πολλὰς</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMS">δ᾽</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMT">ἰφθίμους</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMV">ψυχὰς</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMW">Ἄϊδι</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMX">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EMZ">ἡρώων,</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EN0">αὐτοὺς</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EN1">δὲ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EN2">ἕλωρα</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EN3">τεῦχε</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EN4">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EN6">οἰωνοῖσί</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EN7">τε</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EN8">πᾶσι,</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EN9">Διὸς</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENA">δ᾽</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENB">ἐτελείετο</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENC">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENE">Ἀτρεΐδης</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENF">τε</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENG">ἄναξ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENH">ἀνδρῶν</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENJ">καὶ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENK">δῖος</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENM">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENP">τίς</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENQ">τ᾽</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENR">ἄρ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENS">σφωε</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENT">θεῶν</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENV">ἔριδι</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENW">συνέηκε</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENX">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M77QT5CNSHGBX5QJHDDN2ENZ">Διὸς</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EP0">καὶ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EP1">Λητοῦς</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EP2">υἱός·</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EP3">ὁ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EP4">γὰρ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EP5">βασιλῆϊ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EP6">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EP8">νοῦσον</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EP9">ἀνὰ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EPA">στρατὸν</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EPB">ὄρσε</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EPC">κακήν,</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EPD">ὀλέκοντο</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EPE">δὲ</w> <w xml:id="w-01M77QT5CNSHGBX5QJHDDN2EPF">λαοί,</w></ab>
    </body>
