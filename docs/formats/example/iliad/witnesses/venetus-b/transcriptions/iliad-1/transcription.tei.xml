      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M74HP0BYHFX78S7A6V08J6PR">μῆνιν</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6PS">ἄειδε</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6PT">θεὰ</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6PV">Πηληϊάδεω</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6PW">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M74HP0BYHFX78S7A6V08J6PY">οὐλομένην,</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6PZ">ἣ</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6Q0">μυρία</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6Q1">Ἀχαιοῖς</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6Q2">ἄλγεα</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6Q3">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M74HP0BYHFX78S7A6V08J6Q5">πολλὰς</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6Q6">δ᾽</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6Q7">ἰφθίμους</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6Q8">ψυχὰς</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6Q9">Ἄϊδι</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6QA">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M74HP0BYHFX78S7A6V08J6QC">ἡρώων,</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6QD">αὐτοὺς</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6QE">δὲ</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6QF">ἕλωρα</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6QG">τεῦχε</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6QH">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M74HP0BYHFX78S7A6V08J6QK">οἰωνοῖσί</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6QM">τε</w> <w xml:id="w-01M74HP0BYHFX78S7A6V08J6QN">πᾶσι,</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0H">Διὸς</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0J">δ᾽</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0K">ἐτελείετο</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0M">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M74HP0BZ30ZA0695BX0PET0P">Ἀτρεΐδης</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0Q">τε</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0R">ἄναξ</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0S">ἀνδρῶν</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0T">καὶ</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0V">δῖος</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0W">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M74HP0BZ30ZA0695BX0PET0Y">τίς</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET0Z">τ᾽</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET10">ἄρ</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET11">σφωε</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET12">θεῶν</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET13">ἔριδι</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET14">συνέηκε</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET15">μάχεσθαι;</w>
