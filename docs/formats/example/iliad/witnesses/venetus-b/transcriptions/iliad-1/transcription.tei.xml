      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M74HP0BZ30ZA0695BX0PET1G">νοῦσον</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET1H">ἀνὰ</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET1J">στρατὸν</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET1K">ὄρσε</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET1M">κακήν,</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET1N">ὀλέκοντο</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET1P">δὲ</w> <w xml:id="w-01M74HP0BZ30ZA0695BX0PET1Q">λαοί,</w></ab>
