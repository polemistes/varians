      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCE">μῆνιν</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCF">ἄειδε</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCG">θεὰ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCH">Πηληϊάδεω</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCJ">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCM">οὐλομένην,</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCN">ἣ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCP">μυρία</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCQ">Ἀχαιοῖς</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCR">ἄλγεα</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCS">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCV">πολλὰς</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCW">δ᾽</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCX">ἰφθίμους</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCY">ψυχὰς</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVCZ">Ἄϊδι</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVD0">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVD2">ἡρώων,</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVD3">αὐτοὺς</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVD4">δὲ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVD5">ἕλωρα</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVD6">τεῦχε</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVD7">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVD9">οἰωνοῖσί</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDA">τε</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDB">πᾶσι,</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDC">Διὸς</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDD">δ᾽</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDE">ἐτελείετο</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDF">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDH">Ἀτρεΐδης</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDJ">τε</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDK">ἄναξ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDM">ἀνδρῶν</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDN">καὶ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDP">δῖος</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDQ">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDS">τίς</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDT">τ᾽</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDV">ἄρ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDW">σφωε</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDX">θεῶν</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDY">ἔριδι</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVDZ">συνέηκε</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVE0">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVE2">Διὸς</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVE3">καὶ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVE4">Λητοῦς</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVE5">υἱός·</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVE6">ὁ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVE7">γὰρ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVE8">βασιλῆϊ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVE9">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVEB">νοῦσον</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVEC">ἀνὰ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVED">στρατὸν</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVEE">ὄρσε</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVEF">κακήν,</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVEG">ὀλέκοντο</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVEH">δὲ</w> <w xml:id="w-01M74KBWVRR6FG7S9JP6GXCVEJ">λαοί,</w></ab>
    </body>
