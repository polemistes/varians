      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M71YF5MN03BZAHFG3XHSDCS6">μῆνιν</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCS7">ἄειδε</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCS8">θεὰ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCS9">Πηληϊάδεω</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSA">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSC">οὐλομένην,</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSD">ἣ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSE">μυρία</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSF">Ἀχαιοῖς</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSG">ἄλγεα</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSH">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSK">πολλὰς</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSM">δ᾽</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSN">ἰφθίμους</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSP">ψυχὰς</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSQ">Ἄϊδι</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSR">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M71YF5MN03BZAHFG3XHSDCST">ἡρώων,</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSV">αὐτοὺς</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSW">δὲ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSX">ἕλωρα</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSY">τεῦχε</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCSZ">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M71YF5MN03BZAHFG3XHSDCT1">οἰωνοῖσί</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCT2">τε</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCT3">πᾶσι,</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCT4">Διὸς</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCT5">δ᾽</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCT6">ἐτελείετο</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCT7">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M71YF5MN03BZAHFG3XHSDCT9">Ἀτρεΐδης</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTA">τε</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTB">ἄναξ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTC">ἀνδρῶν</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTD">καὶ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTE">δῖος</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTF">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTH">τίς</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTJ">τ᾽</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTK">ἄρ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTM">σφωε</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTN">θεῶν</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTP">ἔριδι</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTQ">συνέηκε</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTR">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTT">Διὸς</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTV">καὶ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTW">Λητοῦς</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTX">υἱός·</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTY">ὁ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCTZ">γὰρ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCV0">βασιλῆϊ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCV1">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M71YF5MN03BZAHFG3XHSDCV3">νοῦσον</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCV4">ἀνὰ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCV5">στρατὸν</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCV6">ὄρσε</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCV7">κακήν,</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCV8">ὀλέκοντο</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCV9">δὲ</w> <w xml:id="w-01M71YF5MN03BZAHFG3XHSDCVA">λαοί,</w></ab>
    </body>
