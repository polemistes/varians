      <ab><milestone unit="segment" n="1.1"/><w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVWN">μῆνιν</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVWP">ἄειδε</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVWQ">θεὰ</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVWR">Πηληϊάδεω</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVWS">Ἀχιλῆος</w>
      <lb/><milestone unit="segment" n="1.2"/><w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVWV">οὐλομένην,</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVWW">ἣ</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVWX">μυρία</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVWY">Ἀχαιοῖς</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVWZ">ἄλγεα</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVX0">θῆκε,</w>
      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVX2">πολλὰς</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVX3">δ᾽</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVX4">ἰφθίμους</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVX5">ψυχὰς</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVX6">Ἄϊδι</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVX7">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVX9">ἡρώων,</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXA">αὐτοὺς</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXB">δὲ</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXC">ἕλωρα</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXD">τεῦχε</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXE">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXG">οἰωνοῖσί</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXH">τε</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXJ">πᾶσι,</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXK">Διὸς</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXM">δ᾽</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXN">ἐτελείετο</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXP">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXR">Ἀτρεΐδης</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXS">τε</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXT">ἄναξ</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXV">ἀνδρῶν</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXW">καὶ</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXX">δῖος</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVXY">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVY0">τίς</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVY1">τ᾽</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVY2">ἄρ</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVY3">σφωε</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVY4">θεῶν</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVY5">ἔριδι</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVY6">συνέηκε</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVY7">μάχεσθαι;</w>
      <lb/><milestone unit="segment" n="1.9"/><w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVY9">Διὸς</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVYA">καὶ</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVYB">Λητοῦς</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVYC">υἱός·</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVYD">ὁ</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVYE">γὰρ</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVYF">βασιλῆϊ</w> <w xml:id="w-01M72TX5FC8FEPSJ7F3AVDKVYG">χολωθεὶς</w>
      <lb/><milestone unit="segment" n="1.10"/><w xml:id="w-01M72TX5FD8P83J5AF91T340Y3">νοῦσον</w> <w xml:id="w-01M72TX5FD8P83J5AF91T340Y4">ἀνὰ</w> <w xml:id="w-01M72TX5FD8P83J5AF91T340Y5">στρατὸν</w> <w xml:id="w-01M72TX5FD8P83J5AF91T340Y6">ὄρσε</w> <w xml:id="w-01M72TX5FD8P83J5AF91T340Y7">κακήν,</w> <w xml:id="w-01M72TX5FD8P83J5AF91T340Y8">ὀλέκοντο</w> <w xml:id="w-01M72TX5FD8P83J5AF91T340Y9">δὲ</w> <w xml:id="w-01M72TX5FD8P83J5AF91T340YA">λαοί,</w></ab>
    </body>
