      <lb/><milestone unit="segment" n="1.3"/><w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ4W">πολλὰς</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ4X">δ᾽</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ4Y">ἰφθίμους</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ4Z">ψυχὰς</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ50">Ἄϊδι</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ51">προΐαψεν</w>
      <lb/><milestone unit="segment" n="1.4"/><w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ53">ἡρώων,</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ54">αὐτοὺς</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ55">δὲ</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ56">ἕλωρα</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ57">τεῦχε</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ58">κύνεσσιν</w>
      <lb/><milestone unit="segment" n="1.5"/><w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ5A">οἰωνοῖσί</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ5B">τε</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ5C">πᾶσι,</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ5D">Διὸς</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ5E">δ᾽</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ5F">ἐτελείετο</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ5G">βουλή,</w>
      <lb/><milestone unit="segment" n="1.7"/><w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ5J">Ἀτρεΐδης</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ5K">τε</w> <w xml:id="w-01M6Z5QJCNR4HVEJ2KC1Q3NZ5M">ἄναξ</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG695">ἀνδρῶν</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG696">καὶ</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG697">δῖος</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG698">Ἀχιλλεύς.</w>
      <lb/><milestone unit="segment" n="1.8"/><w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG69A">τίς</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG69B">τ᾽</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG69C">ἄρ</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG69D">σφωε</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG69E">θεῶν</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG69F">ἔριδι</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG69G">συνέηκε</w> <w xml:id="w-01M6Z5QJCPY0QHW9ZNCA0WG69H">μάχεσθαι;</w>
