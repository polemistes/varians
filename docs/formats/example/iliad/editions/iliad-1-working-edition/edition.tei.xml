    <front><div type="preface"><p>The opening of the Iliad, collated from three witnesses. A worked example, not a verified text.</p></div></front>
    <body>
      <div type="edition">
        <ab n="1.1" xml:id="seg-01M71ZVR54W83V64BKB6KC4S02" corresp="urn:cts:greekLit:tlg0012.tlg001:1.1"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCC0" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADAR">μῆνιν</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCC1" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADAS">ἄειδε</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCC2" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADAT">θεὰ</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCC3" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADAV">Πηληϊάδεω</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCC4" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADAW">Ἀχιλῆος</w><lb/></ab>
        <ab n="1.2" xml:id="seg-01M71ZVR58GTV3TPFA68AJW5G2" corresp="urn:cts:greekLit:tlg0012.tlg001:1.2"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCC6" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADAY">οὐλομένην,</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCC7" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADAZ">ἣ</w> <app><lem wit="#wit-A #wit-C"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCC8" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADB0">μυρί᾽</w></lem><rdg wit="#wit-B">μυρία</rdg></app> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCC9" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADB1">Ἀχαιοῖς</w> <app><lem wit="#wit-A #wit-C"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCCA" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADB2">ἄλγε᾽</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCB" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADB3">ἔθηκε,</w></lem><rdg wit="#wit-B">ἄλγεα θῆκε,</rdg></app><lb/></ab>
        <ab n="1.3" xml:id="seg-01M71ZVR5BPTN5NPYV7SAYQRC5" corresp="urn:cts:greekLit:tlg0012.tlg001:1.3"><app><lem wit="#wit-A #wit-B"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCCD" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADB5">πολλὰς</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCE" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADB6">δ᾽</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCF" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADB7">ἰφθίμους</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCG" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADB8">ψυχὰς</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCH" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADB9">Ἄϊδι</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCJ" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBA">προΐαψεν</w></lem><rdg wit="#wit-C"/></app><lb/></ab>
        <ab n="1.4" xml:id="seg-01M71ZVR5EWX577PX7FMT6Q1M3" corresp="urn:cts:greekLit:tlg0012.tlg001:1.4"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCCM" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBC">ἡρώων,</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCN" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBD">αὐτοὺς</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCP" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBE">δὲ</w> <app><lem wit="#wit-A #wit-C"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCCQ" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBF">ἑλώρια</w></lem><rdg wit="#wit-B">ἕλωρα</rdg></app> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCR" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBG">τεῦχε</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCS" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBH">κύνεσσιν</w><lb/></ab>
        <ab n="1.5" xml:id="seg-01M71ZVR5GVT76X6AWN222XXJG" corresp="urn:cts:greekLit:tlg0012.tlg001:1.5"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCCV" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBK">οἰωνοῖσί</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCW" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBM">τε</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCX" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBN">πᾶσι,</w> <app><lem wit="#wit-A #wit-B"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCCY" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBP">Διὸς</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCCZ" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBQ">δ᾽</w></lem><rdg wit="#wit-C"><gap reason="lost"/></rdg></app> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCD0" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBR">ἐτελείετο</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCD1" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADBS">βουλή,</w><lb/></ab>
