        <ab n="1.10" xml:id="seg-01M71ZVR5XDT3JN88R4F5QESXN" corresp="urn:cts:greekLit:tlg0012.tlg001:1.10"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCE5" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCX">νοῦσον</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCE6" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCY">ἀνὰ</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCE7" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCZ">στρατὸν</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCE8" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADD0">ὄρσε</w> <app><lem wit="#wit-A #wit-B"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCE9" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADD1">κακήν,</w></lem><rdg wit="#wit-C">κακά,</rdg></app> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCEA" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADD2">ὀλέκοντο</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCEB" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADD3">δὲ</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCEC" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADD4">λαοί,</w></ab>
