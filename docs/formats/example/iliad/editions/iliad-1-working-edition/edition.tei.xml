        <ab n="1.8" xml:id="seg-01M71YF5K20GC82BBA8R2GC1QQ" corresp="urn:cts:greekLit:tlg0012.tlg001:1.8"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGE" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBD">τίς</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGF" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBE">τ᾽</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGG" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBF">ἄρ</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGH" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBG">σφωε</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGJ" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBH">θεῶν</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGK" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBJ">ἔριδι</w> <app><lem wit="#wit-A #wit-C"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGM" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBK">ξυνέηκε</w></lem><rdg wit="#wit-B">συνέηκε</rdg></app> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGN" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBM">μάχεσθαι;</w><lb/></ab>
        <ab n="1.9" xml:id="seg-01M71YF5K50RQ77GQCCSNEBK01" corresp="urn:cts:greekLit:tlg0012.tlg001:1.9"><app><lem wit="#wit-A #wit-C"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGQ" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBP">Λητοῦς</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGR" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBQ">καὶ</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGS" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBR">Διὸς</w></lem><rdg wit="#wit-B">Διὸς καὶ Λητοῦς</rdg></app> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGT" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBS">υἱός·</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGV" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBT">ὁ</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGW" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBV">γὰρ</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGX" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBW">βασιλῆϊ</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBGY" corresp="tok:01M71YF5KM43T3V4B2TA3MFFBX">χολωθεὶς</w><lb/></ab>
