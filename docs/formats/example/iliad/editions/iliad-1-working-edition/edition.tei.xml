        <ab n="1.7" xml:id="seg-01M71ZVR5NDX9X38CB68D1Y4YF" corresp="urn:cts:greekLit:tlg0012.tlg001:1.7"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCDB" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADC3">Ἀτρεΐδης</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDC" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADC4">τε</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDD" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADC5">ἄναξ</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDE" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADC6">ἀνδρῶν</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDF" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADC7">καὶ</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDG" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADC8">δῖος</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDH" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADC9">Ἀχιλλεύς.</w><lb/></ab>
        <ab n="1.8" xml:id="seg-01M71ZVR5RBCZHCXVNZCR7KRMD" corresp="urn:cts:greekLit:tlg0012.tlg001:1.8"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCDK" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCB">τίς</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDM" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCC">τ᾽</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDN" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCD">ἄρ</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDP" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCE">σφωε</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDQ" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCF">θεῶν</w> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDR" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCG">ἔριδι</w> <app><lem wit="#wit-A #wit-C"><w xml:id="w-01M71ZVR8CV12598W8MQVHJCDS" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCH">ξυνέηκε</w></lem><rdg wit="#wit-B">συνέηκε</rdg></app> <w xml:id="w-01M71ZVR8CV12598W8MQVHJCDT" corresp="tok:01M71ZVR68FHJ84BMYH6A2ADCJ">μάχεσθαι;</w><lb/></ab>
