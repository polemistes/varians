    <front><div type="preface"><p>The opening of the Iliad, collated from three witnesses. A worked example, not a verified text.</p></div></front>
    <body>
      <div type="edition">
        <ab n="1.1" xml:id="seg-01M71YF5JDR7YYD3T6EWQ5RMWT" corresp="urn:cts:greekLit:tlg0012.tlg001:1.1"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBEV" corresp="tok:01M71YF5KKJNM3DMYCP8CHERJQ">μῆνιν</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBEW" corresp="tok:01M71YF5KM43T3V4B2TA3MFF9V">ἄειδε</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBEX" corresp="tok:01M71YF5KM43T3V4B2TA3MFF9W">θεὰ</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBEY" corresp="tok:01M71YF5KM43T3V4B2TA3MFF9X">Πηληϊάδεω</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBEZ" corresp="tok:01M71YF5KM43T3V4B2TA3MFF9Y">Ἀχιλῆος</w><lb/></ab>
        <ab n="1.2" xml:id="seg-01M71YF5JH0MS9040T6ARDHD60" corresp="urn:cts:greekLit:tlg0012.tlg001:1.2"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBF1" corresp="tok:01M71YF5KM43T3V4B2TA3MFFA0">οὐλομένην,</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBF2" corresp="tok:01M71YF5KM43T3V4B2TA3MFFA1">ἣ</w> <app><lem wit="#wit-A #wit-C"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBF3" corresp="tok:01M71YF5KM43T3V4B2TA3MFFA2">μυρί᾽</w></lem><rdg wit="#wit-B">μυρία</rdg></app> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBF4" corresp="tok:01M71YF5KM43T3V4B2TA3MFFA3">Ἀχαιοῖς</w> <app><lem wit="#wit-A #wit-C"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBF5" corresp="tok:01M71YF5KM43T3V4B2TA3MFFA4">ἄλγε᾽</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBF6" corresp="tok:01M71YF5KM43T3V4B2TA3MFFA5">ἔθηκε,</w></lem><rdg wit="#wit-B">ἄλγεα θῆκε,</rdg></app><lb/></ab>
        <ab n="1.3" xml:id="seg-01M71YF5JN7MGAC16VM21BD1G1" corresp="urn:cts:greekLit:tlg0012.tlg001:1.3"><app><lem wit="#wit-A #wit-B"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBF8" corresp="tok:01M71YF5KM43T3V4B2TA3MFFA7">πολλὰς</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBF9" corresp="tok:01M71YF5KM43T3V4B2TA3MFFA8">δ᾽</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFA" corresp="tok:01M71YF5KM43T3V4B2TA3MFFA9">ἰφθίμους</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFB" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAA">ψυχὰς</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFC" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAB">Ἄϊδι</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFD" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAC">προΐαψεν</w></lem><rdg wit="#wit-C"/></app><lb/></ab>
        <ab n="1.4" xml:id="seg-01M71YF5JQVDYXZPQK6K6SK2V8" corresp="urn:cts:greekLit:tlg0012.tlg001:1.4"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFF" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAE">ἡρώων,</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFG" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAF">αὐτοὺς</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFH" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAG">δὲ</w> <app><lem wit="#wit-A #wit-C"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFJ" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAH">ἑλώρια</w></lem><rdg wit="#wit-B">ἕλωρα</rdg></app> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFK" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAJ">τεῦχε</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFM" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAK">κύνεσσιν</w><lb/></ab>
        <ab n="1.5" xml:id="seg-01M71YF5JVX7AXC8YSYVX5XJZQ" corresp="urn:cts:greekLit:tlg0012.tlg001:1.5"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFP" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAN">οἰωνοῖσί</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFQ" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAP">τε</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFR" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAQ">πᾶσι,</w> <app><lem wit="#wit-A #wit-B"><w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFS" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAR">Διὸς</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFT" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAS">δ᾽</w></lem><rdg wit="#wit-C"><gap reason="lost"/></rdg></app> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFV" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAT">ἐτελείετο</w> <w xml:id="w-01M71YF5NPBDG7N4PR8DFSFBFW" corresp="tok:01M71YF5KM43T3V4B2TA3MFFAV">βουλή,</w><lb/></ab>
