{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varians.eu/formats/2/memory.schema.json",
  "title": "Normalization memory",
  "description": "memory.json: written forms with the read forms confirmed for them (specification 4.9).",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://varians.eu/formats/2/memory.schema.json"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "form": {
            "type": "string"
          },
          "norm": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "form",
          "norm"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "entries"
  ]
}
