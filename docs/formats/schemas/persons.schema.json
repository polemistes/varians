{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varians.eu/formats/2/persons.schema.json",
  "title": "Persons",
  "description": "persons.json: every person the files of an archive refer to (specification 4.2).",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://varians.eu/formats/2/persons.schema.json"
    },
    "persons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "orcid": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "persons"
  ]
}
