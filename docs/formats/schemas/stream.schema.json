{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varians.no/schemas/stream.schema.json",
  "title": "Stream",
  "description": "The text of a transcription or an edition: an ordered list of tokens, breaks and objects. Every item has a permanent id.",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "segmentStart": {
      "type": "object",
      "required": ["segmentId"],
      "properties": {
        "segmentId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "description": "The segment a run of which begins here; null begins unassigned text." },
        "part": { "type": "integer", "minimum": 1, "description": "Content order of this run among the segment's runs in the stream." }
      }
    },
    "mark": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "description": "A TEI element name: unclear, supplied, del, add, subst, abbr, hi, sic, corr, damage, surplus, handShift, space, gap, crux, note." },
        "attrs": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
        "from": { "type": "integer", "minimum": 0, "description": "Start, in code points of the written form; absent for a whole-token mark." },
        "to": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "oneOf": [
        { "type": "object", "required": ["kind", "transcriptionId", "tokenIds"], "properties": { "kind": { "const": "witness" }, "transcriptionId": { "$ref": "#/$defs/id" }, "tokenIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
        { "type": "object", "required": ["kind", "conjectureId"], "properties": { "kind": { "const": "conjecture" }, "conjectureId": { "$ref": "#/$defs/id" } } },
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "editor" } } }
      ]
    },
    "token": {
      "type": "object",
      "required": ["kind", "id", "form"],
      "properties": {
        "kind": { "const": "token" },
        "id": { "$ref": "#/$defs/id" },
        "form": { "type": "string", "description": "The written form." },
        "norm": { "type": "string", "description": "The read form where it differs; spaces divide it into several words for collation." },
        "unchecked": { "type": "boolean" },
        "joinNext": { "type": "boolean", "description": "This token and the next are one word." },
        "sep": { "enum": ["space", "none", "interpunct", "other"] },
        "segment": { "$ref": "#/$defs/segmentStart" },
        "marks": { "type": "array", "items": { "$ref": "#/$defs/mark" } },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "break": {
      "type": "object",
      "required": ["kind", "id", "type"],
      "properties": {
        "kind": { "const": "break" },
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["line", "column", "page", "paragraph"] },
        "pageId": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "rend": { "type": "string" }
      }
    },
    "object": {
      "type": "object",
      "required": ["kind", "id", "type"],
      "properties": {
        "kind": { "const": "object" },
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["gap", "figure", "mark", "note", "lacuna", "paratext", "space"] },
        "attrs": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
        "text": { "type": "string" },
        "segment": { "$ref": "#/$defs/segmentStart" }
      }
    },
    "item": { "oneOf": [{ "$ref": "#/$defs/token" }, { "$ref": "#/$defs/break" }, { "$ref": "#/$defs/object" }] }
  }
}
