{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varians.eu/formats/2/stream.schema.json",
  "title": "Stream",
  "description": "The text of a transcription or an edition: an ordered list of tokens, breaks and objects, each with a permanent id (specification 4.8). Also the operations that change it (5.2).",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "https://varians.eu/formats/2/stream.schema.json#/$defs/item"
      }
    }
  },
  "$defs": {
    "segmentStart": {
      "type": "object",
      "properties": {
        "segmentId": {
          "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/idOrNull"
        },
        "part": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "segmentId"
      ]
    },
    "mark": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind"
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "witness"
            },
            "transcriptionId": {
              "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
            },
            "tokenIds": {
              "type": "array",
              "items": {
                "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
              }
            }
          },
          "required": [
            "kind",
            "transcriptionId",
            "tokenIds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "conjecture"
            },
            "conjectureId": {
              "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "conjectureId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "editor"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "token": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "token"
        },
        "id": {
          "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
        },
        "form": {
          "type": "string"
        },
        "norm": {
          "type": "string"
        },
        "unchecked": {
          "type": "boolean"
        },
        "joinNext": {
          "type": "boolean"
        },
        "sep": {
          "enum": [
            "space",
            "none",
            "interpunct",
            "other"
          ]
        },
        "segment": {
          "$ref": "https://varians.eu/formats/2/stream.schema.json#/$defs/segmentStart"
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "https://varians.eu/formats/2/stream.schema.json#/$defs/mark"
          }
        },
        "source": {
          "$ref": "https://varians.eu/formats/2/stream.schema.json#/$defs/source"
        }
      },
      "required": [
        "kind",
        "id",
        "form"
      ]
    },
    "break": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "break"
        },
        "id": {
          "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
        },
        "type": {
          "enum": [
            "line",
            "column",
            "page",
            "paragraph"
          ]
        },
        "pageId": {
          "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "rend": {
          "type": "string"
        },
        "lineation": {
          "enum": [
            "verse",
            "prose"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "type"
      ]
    },
    "object": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "object"
        },
        "id": {
          "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
        },
        "type": {
          "enum": [
            "gap",
            "figure",
            "mark",
            "note",
            "lacuna",
            "paratext",
            "space"
          ]
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "text": {
          "type": "string"
        },
        "segment": {
          "$ref": "https://varians.eu/formats/2/stream.schema.json#/$defs/segmentStart"
        }
      },
      "required": [
        "kind",
        "id",
        "type"
      ]
    },
    "item": {
      "oneOf": [
        {
          "$ref": "https://varians.eu/formats/2/stream.schema.json#/$defs/token"
        },
        {
          "$ref": "https://varians.eu/formats/2/stream.schema.json#/$defs/break"
        },
        {
          "$ref": "https://varians.eu/formats/2/stream.schema.json#/$defs/object"
        }
      ]
    },
    "op": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "insert"
            },
            "after": {
              "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/idOrNull"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "https://varians.eu/formats/2/stream.schema.json#/$defs/item"
              }
            }
          },
          "required": [
            "t",
            "after",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "delete"
            },
            "ids": {
              "type": "array",
              "items": {
                "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
              }
            }
          },
          "required": [
            "t",
            "ids"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "set"
            },
            "id": {
              "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
            },
            "fields": {
              "type": "object"
            }
          },
          "required": [
            "t",
            "id",
            "fields"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "move"
            },
            "ids": {
              "type": "array",
              "items": {
                "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
              }
            },
            "after": {
              "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/idOrNull"
            }
          },
          "required": [
            "t",
            "ids",
            "after"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "split"
            },
            "id": {
              "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
            },
            "at": {
              "type": "integer",
              "minimum": 0
            },
            "newId": {
              "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
            },
            "join": {
              "type": "boolean"
            }
          },
          "required": [
            "t",
            "id",
            "at",
            "newId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "join"
            },
            "id": {
              "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
            }
          },
          "required": [
            "t",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "replace"
            },
            "ids": {
              "type": "array",
              "items": {
                "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
              }
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "https://varians.eu/formats/2/stream.schema.json#/$defs/item"
              }
            }
          },
          "required": [
            "t",
            "ids",
            "items"
          ]
        }
      ]
    }
  }
}
