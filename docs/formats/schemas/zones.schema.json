{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varians.eu/formats/2/zones.schema.json",
  "title": "Zones",
  "description": "zones.json: areas of page images and the tokens they show (specification 4.9).",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://varians.eu/formats/2/zones.schema.json"
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
          },
          "pageId": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
          },
          "tokenIds": {
            "type": "array",
            "items": {
              "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
            }
          },
          "geometry": {
            "type": "object",
            "properties": {
              "rect": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ]
              },
              "polygon": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                }
              },
              "rotate": {
                "type": "number"
              }
            }
          },
          "feature": {
            "type": [
              "object",
              "null"
            ]
          },
          "createdAt": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/timeOrNull"
          }
        },
        "required": [
          "id",
          "pageId",
          "tokenIds",
          "geometry"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "zones"
  ]
}
