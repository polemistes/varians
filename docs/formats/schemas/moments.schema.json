{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varians.eu/formats/2/moments.schema.json",
  "title": "Moments",
  "description": "moments.json: named and published moments of a document's history (specification 5.4).",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://varians.eu/formats/2/moments.schema.json"
    },
    "moments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "named",
              "published"
            ]
          },
          "number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "basis": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "sigla": {
                "type": "array",
                "items": {
                  "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/siglum"
                }
              },
              "versions": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            }
          },
          "personId": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/idOrNull"
          },
          "at": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/time"
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "kind",
          "at"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "moments"
  ]
}
