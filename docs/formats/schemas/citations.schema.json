{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varians.eu/formats/2/citations.schema.json",
  "title": "Citations",
  "description": "citations.json: which record cites which bibliography entry (specification 4.5).",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://varians.eu/formats/2/citations.schema.json"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
          },
          "itemId": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
          },
          "conjectureId": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/idOrNull"
          },
          "reportedReadingId": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/idOrNull"
          },
          "noteId": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/idOrNull"
          },
          "editionId": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/idOrNull"
          },
          "segmentId": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/idOrNull"
          },
          "prenote": {
            "type": [
              "string",
              "null"
            ]
          },
          "postnote": {
            "type": [
              "string",
              "null"
            ]
          },
          "position": {
            "type": "integer"
          },
          "createdAt": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/timeOrNull"
          }
        },
        "required": [
          "id",
          "itemId"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "citations"
  ]
}
