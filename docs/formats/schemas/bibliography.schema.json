{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varians.eu/formats/2/bibliography.schema.json",
  "title": "Bibliography",
  "description": "bibliography.json: every bibliography entry cited in an archive (specification 4.5).",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://varians.eu/formats/2/bibliography.schema.json"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/id"
          },
          "entryType": {
            "type": "string"
          },
          "citationKey": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "label": {
            "type": "string"
          },
          "createdBy": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/idOrNull"
          },
          "createdAt": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/timeOrNull"
          },
          "updatedAt": {
            "$ref": "https://varians.eu/formats/2/common.schema.json#/$defs/timeOrNull"
          }
        },
        "required": [
          "id",
          "entryType",
          "citationKey",
          "fields",
          "label"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "items"
  ]
}
