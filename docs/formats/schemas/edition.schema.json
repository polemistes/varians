{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varians.no/schemas/edition.schema.json",
  "title": "Edition",
  "type": "object",
  "required": ["id", "slug", "title", "version", "conventions", "sigla", "content"],
  "properties": {
    "id": { "type": "string" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "editors": { "type": "array", "items": { "type": "string" }, "description": "The editors' names, as printed." },
    "preface": { "type": ["string", "null"] },
    "ownerId": { "type": "string" },
    "ownerName": { "type": ["string", "null"] },
    "visibility": { "enum": ["draft", "published"] },
    "version": { "type": "integer" },
    "publishedVersion": { "type": ["integer", "null"] },
    "conventions": {
      "type": "object",
      "properties": {
        "apparatus": { "enum": ["positive", "negative"] },
        "orthographica": { "type": "boolean" },
        "latin": { "type": "boolean" },
        "lineation": { "enum": ["verse", "prose"] },
        "numberEvery": { "type": "integer" },
        "speakerDisplay": { "enum": ["inline", "margin", "own-line"] },
        "sources": { "type": ["string", "null"], "description": "What it rests on or was made from, as its maker states it." },
    "licence": { "type": ["string", "null"], "description": "The licence it is published under." },
    "copiedFrom": {
      "type": ["object", "null"],
      "description": "The edition this one was copied from, as it was then.",
      "properties": {
        "editionId": { "type": "string" },
        "title": { "type": "string" },
        "editors": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "integer", "description": "The document version copied." },
        "published": { "type": "boolean", "description": "Whether a published version was copied, rather than the draft by one of its editors." },
        "number": { "type": ["integer", "null"], "description": "The published version's number, as readers cite it." }
      }
    },
    "sigla": { "type": "object" }
      }
    },
    "sigla": {
      "type": "array",
      "description": "The conspectus, in order.",
      "items": {
        "type": "object",
        "required": ["siglum", "witnessId"],
        "properties": {
          "siglum": { "type": "string" },
          "witnessId": { "type": "string" },
          "transcriptionId": { "type": ["string", "null"] },
          "states": {
            "type": "array",
            "description": "Further states of the witness collated under sigla of their own. Archives written before 8 November 2026 have originalSiglum instead, the siglum of the state before correction.",
            "items": {
              "type": "object",
              "required": ["kind", "siglum"],
              "properties": {
                "kind": { "enum": ["original", "stage", "hand"] },
                "siglum": { "type": "string" },
                "stage": { "type": "integer", "description": "For kind stage: the corrections of stages 1 to this one are applied." },
                "hand": { "type": "string", "description": "For kind hand: the hand whose corrections are applied, as the marks name it (a hand id, scribe or other)." }
              }
            }
          },
          "variantSiglum": { "type": ["string", "null"] }
        }
      }
    },
    "adoptions": { "type": "array", "items": { "type": "string" }, "description": "Ids of adopted conjectures." },
    "notes": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "segmentId": { "type": "string" }, "segmentLabel": { "type": ["string", "null"] }, "tokenIds": { "type": "array", "items": { "type": "string" } }, "text": { "type": "string" }, "authorId": { "type": ["string", "null"] } } } },
    "content": { "$ref": "stream.schema.json" }
  }
}
