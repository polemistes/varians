# The environment the end-to-end tests run against. Loaded by `vite dev --mode test`.
# Same as .env, with the test database. Migrate it first:
#   DATABASE_URL=postgres://varians@127.0.0.1:54329/varians_test pnpm --filter @varians/db migrate
DATABASE_URL=postgres://varians@127.0.0.1:54329/varians_test
STORAGE_DIR=../../storage-test
SESSION_SECRET=test-only-secret-not-for-production-0000000000000000000000000000
ORIGIN=http://localhost:4173
